{
  "manifest_version": 3,
  "name": "ReadMEasy",
  "version": "0.1.0",
  "description": "Select text on any page and replace it in place with its English translation (Bengali / Hindi to English).",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Translate selection",
    "default_popup": "popup.html"
  }
}
